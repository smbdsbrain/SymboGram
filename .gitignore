# --- Qt Creator / qmake ---
*.user
*.pro.user.*
*.autosave
moc
obj
rcc/qrc_resources.cpp
Makefile
*.mk
*.cache

# --- Symbian build output (abld generates these into the source tree) ---
bld.inf
*.loc
*.rss
*.mmp
*.pkg
*.sis
*.sisx
ABLD.BAT
*test

# --- built binary (renamed from upstream's "Kutegram") ---
SymboGram

# --- desktop (Qt 4.8.7 / MinGW) shadow build, used for autonomous testing ---
/build-desktop/
/build-desktop-debug/

# --- packaged artifacts ---
/dist/

# --- Symbian toolchain, fetched by tools/build-symbian.cmd, never committed ---
/Symbian1Qt473/

# --- secrets: api_id / api_hash / auth keys / signing material ---
/secrets/
# Live Telegram session for the desktop test build (SYMBOGRAM_SESSION_DIR).
# Redundant with /secrets/ above, but spelled out: these files contain a
# usable auth key. Anyone with them is logged into the account.
/secrets/session/
**/SymboGram_user_session.ini
*.authkey
*.session
libkg/apisecrets.h
*.cer
*.key
*.pem
*.p12
*.pfx
.env
.env.*
!.env.example

# --- private working notes, never published (see docs/VENDORED.md rationale) ---
/local/
/private/

# --- Debian / Harmattan packaging output ---
debian
build-stamp
configure-stamp
*.deb
*.changes

# --- editors / OS ---
.vscode/
.idea/
.claude/
Thumbs.db
desktop.ini
.DS_Store
*~
*.swp
*.bak

# --- agent / assistant instructions: local only, never published ---
# Claude Code loads CLAUDE.md from the repo root, so it cannot live under
# /local/. It is ignored by name instead; the substance lives in
# local/project-notes/agents/ and the root file only imports it.
# Unanchored on purpose: a nested src/CLAUDE.md is auto-loaded too.
CLAUDE.md
AGENTS.md
GEMINI.md
.cursor/
.cursorrules
.windsurfrules
.aider*
.continue/
.codex/
.github/copilot-instructions.md
/notes/
/docs/local/
/scratch/

# --- compiled objects and binaries: nothing built locally is ever published ---
# A local build embeds api_hash as a plain string literal, and a debug build
# also embeds the developer's home path. See docs/security.md.
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.dso
*.map
*.sym
*.lst
*.tmp

# --- qmake/moc/uic/rcc generated sources ---
# Leading slash on the directories so these cannot reach into the vendored
# libkg/mbedtls/ and pigler/ trees.
moc_*.cpp
qrc_*.cpp
ui_*.h
/ui/
/rcc/
/moc/
/obj/

# --- runtime spill: the session lives in secrets/, but a stray copy of any of
# --- these is an account takeover, so keep them ignored wherever they land ---
*.log
**/SymboGram_cache.ini
**/SymboGram_avatars/
**/SymboGram_photos/
**/SymboGram_user_session/
*_session.ini

# --- additional key / signing material ---
*.crt
*.der
*.jks
*.keystore
*.p8
*.asc
*.gpg
id_rsa*

# --- explicit keeps: tracked files an earlier rule would otherwise shadow ---
!config/telegram.yaml.example
!libkg/apisecrets.h.empty
# Upstream zlib linker version script -- a source file, not a linker map.
# Caught by *.map above; tools/audit-public.ps1 check (i) found it.
!libkg/zlib/zlib.map
